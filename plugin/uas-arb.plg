<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "uas-arb">
<!ENTITY author    "davilaa">
<!ENTITY version   "2026.10.19">
<!ENTITY repo      "davilaa/ds-sc5b-uas-arbiter">
<!ENTITY gitURL    "https://raw.githubusercontent.com/&repo;/main">
<!ENTITY pluginURL "&gitURL;/plugin/&name;.plg">
<!ENTITY plugin    "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;"
        launch="Settings/UASArb" icon="hdd-o" min="7.0.0"
        support="https://github.com/&repo;/issues">

<CHANGES>
###&version;
- Driver 3.1: code-review fixes - fairness glitch after a drained turn (could cause 1-command turns for up to 400 ms), clamp arb_slice_ms &lt;= 0, explicit unlocked read of the slot token, dead field removed. No correctness or safety bugs were found in the review. Compile-tested W=1 on 6.12.54-Unraid and 7.0; patch applies to 6.6-7.0. The new module is downloaded and loaded at the NEXT BOOT.
- Status page shows the driver version
- Added CHANGELOG.md (full release notes on GitHub)
</CHANGES>

<!-- remove files of a previous version first: the plugin manager skips files that already exist -->
<FILE Run="/bin/bash">
<INLINE>
rm -rf &emhttp;
</INLINE>
</FILE>

<!-- settings defaults -->
<FILE Name="&emhttp;/default.cfg">
<INLINE>
ENABLED="yes"
ARB_LIMIT="4"
UPSTREAM_WEIGHT="2"
ARB_SLICE_MS="100"
MAX_SECTORS="4096"
MATCH="dssc5b"
</INLINE>
</FILE>

<!-- control script -->
<FILE Name="&emhttp;/scripts/uas-arb" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
# uas-arb: control script for the "DS-SC5B UAS Arbiter" Unraid plugin.
#
#   uas-arb start          load uas_arb for the running kernel and move the DS-SC5B bridges onto it
#                          (run by the plugin at install/boot, before the array starts)
#   uas-arb apply          apply settings from the plugin config (called by the settings page)
#   uas-arb stop           arbiter off; if the array is stopped, give the drives back to stock uas and unload
#   uas-arb rebind [IFACE] move matching bridge interfaces from uas to uas_arb (manual)
#   uas-arb rebind-later IFACE   same, after 3 s (used by the udev rule)
#   uas-arb status         plain-text status
#
# Safety rule: drives are only moved between drivers at boot, before Unraid's emhttpd records the array
# disks' device names (moving a bridge re-creates its disk under a new name). Otherwise: next boot.

PLG=uas-arb
CFGDIR=/boot/config/plugins/$PLG
CFG=$CFGDIR/$PLG.cfg
DEFCFG=/usr/local/emhttp/plugins/$PLG/default.cfg
REPO=davilaa/ds-sc5b-uas-arbiter
KR=$(uname -r)
MODDIR=$CFGDIR/modules/$KR
MOD=$MODDIR/uas_arb.ko
PARAMS=/sys/module/uas_arb/parameters
RULE=/etc/udev/rules.d/99-uas-arb.rules
SELF=/usr/local/emhttp/plugins/$PLG/scripts/uas-arb

log() { logger -t uas-arb -- "$*"; echo "$*"; }
notify() { /usr/local/emhttp/webGui/scripts/notify -e "DS-SC5B UAS Arbiter" -s "$1" -d "$2" -i "${3:-warning}" >/dev/null 2>&1; }

# read KEY="value" from the user config, falling back to defaults (never source the file)
cfg() {
  local v
  v=$(grep -E "^$1=" "$CFG" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"\r')
  [ -z "$v" ] && v=$(grep -E "^$1=" "$DEFCFG" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"\r')
  echo "$v"
}
ENABLED=$(cfg ENABLED); ARB_LIMIT=$(cfg ARB_LIMIT); UPSTREAM_WEIGHT=$(cfg UPSTREAM_WEIGHT)
ARB_SLICE_MS=$(cfg ARB_SLICE_MS); MAX_SECTORS=$(cfg MAX_SECTORS); MATCH=$(cfg MATCH)
[[ $ARB_LIMIT =~ ^[1-9]$ ]] || ARB_LIMIT=4
[[ $UPSTREAM_WEIGHT =~ ^[1-4]$ ]] || UPSTREAM_WEIGHT=2
[[ $ARB_SLICE_MS =~ ^[0-9]+$ ]] && [ "$ARB_SLICE_MS" -ge 5 ] && [ "$ARB_SLICE_MS" -le 1000 ] || ARB_SLICE_MS=100
[[ $MAX_SECTORS =~ ^(0|1024|2048|4096)$ ]] || MAX_SECTORS=4096
[ "$MATCH" = all ] || MATCH=dssc5b

loaded() { [ -d $PARAMS ]; }
array_started() { [ "$(/usr/local/sbin/mdcmd status 2>/dev/null | sed -n 's/^mdState=//p')" = STARTED ]; }
# Unraid's emhttpd records the array disks' device names when it starts. Moving a bridge to another
# driver re-creates its disk with a NEW name, after which the array refuses to start ("Start error",
# md lock_bdev -2) until reboot. So drives are only moved before emhttpd runs, i.e. at boot.
names_recorded() { pgrep -x emhttpd >/dev/null; }

# usb device dir -> is it an ASM235CM bridge we should handle?
is_target() { # $1 = usb device sysfs dir (not the interface)
  [ "$(cat $1/idVendor 2>/dev/null):$(cat $1/idProduct 2>/dev/null)" = "174c:55aa" ] || return 1
  [ "$MATCH" = all ] && return 0
  # DS-SC5B: the bridge must sit behind a VIA VL822 hub (2109:0822 USB3 side, 2109:2822 USB2 side)
  local d=$(dirname $1)
  while [ -f $d/idVendor ]; do
    case "$(cat $d/idVendor):$(cat $d/idProduct)" in 2109:0822|2109:2822) return 0 ;; esac
    d=$(dirname $d)
  done
  return 1
}

slow_bridges() { # print managed bridges that are not on a SuperSpeed (>=5000) link
  local i dev
  for i in /sys/bus/usb/devices/*:1.0; do
    dev=$(dirname "$(readlink -f "$i")")
    is_target "$dev" || continue
    [ "$(cat $dev/speed 2>/dev/null)" -ge 5000 ] 2>/dev/null || echo "$(basename "$dev")@$(cat $dev/speed 2>/dev/null)M"
  done
}

# if the release has a newer build for this kernel, replace the cached copy (quietly skipped when offline)
refresh_module() {
  [ -f "$MOD" ] || return 0
  local base="https://github.com/$REPO/releases/download/modules/uas_arb-$KR.ko" remote
  remote=$(curl -fsSL --connect-timeout 5 --max-time 15 "$base.sha256" 2>/dev/null | cut -d' ' -f1)
  [[ $remote =~ ^[0-9a-f]{64}$ ]] || return 0
  [ "$remote" = "$(sha256sum "$MOD" | cut -d' ' -f1)" ] && return 0
  log "a newer uas_arb build for $KR is available, updating the cached module"
  mv "$MOD" "$MOD.old"
  if fetch_module; then rm -f "$MOD.old"; else mv "$MOD.old" "$MOD"; fi
}

# module parameters, limited to the ones this module build supports (older cached builds lack some)
mod_params() {
  local have=$(modinfo -p "$1" 2>/dev/null | cut -d: -f1) p out=""
  local max=$ARB_LIMIT
  if ! grep -qx arb_upstream_weight <<<"$have"; then max=3; fi      # v2 build: 'any 3 devices'
  for p in "arb_max=$max" "arb_slice_ms=$ARB_SLICE_MS" "arb_upstream_weight=$UPSTREAM_WEIGHT" "arb_max_sectors=$MAX_SECTORS"; do
    grep -qx "${p%%=*}" <<<"$have" && out="$out $p"
  done
  echo $out
}

fetch_module() {
  [ -f "$MOD" ] && return 0
  mkdir -p "$MODDIR"
  local base="https://github.com/$REPO/releases/download/modules/uas_arb-$KR.ko" i
  log "no module cached for kernel $KR, downloading $base"
  for i in 1 2 3 4 5 6; do
    if curl -fsSL --connect-timeout 10 -o "$MOD.tmp" "$base" && curl -fsSL --connect-timeout 10 -o "$MOD.sha256" "$base.sha256"; then
      if [ "$(cut -d' ' -f1 "$MOD.sha256")" = "$(sha256sum "$MOD.tmp" | cut -d' ' -f1)" ]; then
        mv "$MOD.tmp" "$MOD"; log "downloaded and verified uas_arb for $KR"; return 0
      fi
      log "checksum mismatch for downloaded module"; rm -f "$MOD.tmp" "$MOD.sha256"; return 1
    fi
    rm -f "$MOD.tmp"; sleep 10   # network may still be coming up at boot
  done
  return 1
}

install_rule() {
  # the rebind must run outside the udev event (unbinding from inside the bind event doesn't work)
  # triggers on "add" (Unraid's udev doesn't deliver "bind" events to rules); rebind-later waits for uas to claim it
  echo "ACTION==\"add\", SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_interface\", ATTRS{idVendor}==\"174c\", ATTRS{idProduct}==\"55aa\", RUN+=\"/bin/sh -c '/usr/bin/setsid $SELF rebind-later %k </dev/null >/dev/null 2>&1 &'\"" > $RULE
  udevadm control --reload
}

rebind() { # [iface]
  loaded || return 0
  [ "$ENABLED" = yes ] || return 0
  local i id dev n=0
  for i in ${1:+/sys/bus/usb/devices/$1} ${1:-/sys/bus/usb/devices/*:1.0}; do
    [ -e "$i/driver" ] || continue
    [ "$(basename "$(readlink -f "$i/driver")")" = uas ] || continue
    dev=$(dirname "$(readlink -f "$i")")
    is_target "$dev" || continue
    id=$(basename "$i")
    echo "$id" > /sys/bus/usb/drivers/uas/unbind && echo "$id" > /sys/bus/usb/drivers/uas_arb/bind && { log "moved $id to uas_arb"; n=$((n+1)); }
  done
  return 0
}

start() {
  if [ "$ENABLED" != yes ]; then log "disabled in settings, using stock uas"; return 0; fi
  if ! loaded; then
    refresh_module
    if ! fetch_module; then
      log "no uas_arb module for kernel $KR - drives stay on the stock uas driver"
      notify "No module for kernel $KR" "No prebuilt uas_arb for $KR. The DS-SC5B drives use the stock driver (UAS resets possible under heavy load). See the GitHub repo for how to add a kernel." warning
      return 0
    fi
    if [ "$(modinfo -F vermagic "$MOD" | cut -d' ' -f1)" != "$KR" ]; then
      log "cached module does not match kernel $KR, removing it"; rm -f "$MOD"; return 0
    fi
    local params=$(mod_params "$MOD")
    cp "$MOD" /tmp/uas_arb.ko && insmod /tmp/uas_arb.ko $params \
      || { log "insmod failed"; notify "Load failed" "insmod uas_arb failed on $KR, using stock uas" alert; return 1; }
    log "loaded uas_arb ($params) for $KR"
  fi
  install_rule
  local slow=$(slow_bridges | tr '\n' ' ')
  if [ -n "$slow" ]; then
    log "WARNING: enclosure bridges not on a USB 3 link: $slow (USB 2 fallback - replug the USB cable)"
    notify "Enclosure on USB 2" "DS-SC5B bridges came up at USB 2 speed ($slow). Unplug and replug the enclosure's USB cable (not power) while the array is stopped." alert
  fi
  if names_recorded; then
    log "Unraid is running: drives are not moved now (it would rename the array disks); takes effect at the next boot"
  else
    rebind
  fi
}

apply() {
  if loaded; then
    local max=$ARB_LIMIT
    if [ -w $PARAMS/arb_upstream_weight ]; then echo "$UPSTREAM_WEIGHT" > $PARAMS/arb_upstream_weight; else max=3; fi
    if [ "$ENABLED" = yes ]; then echo "$max" > $PARAMS/arb_max; else echo 0 > $PARAMS/arb_max; fi
    echo "$ARB_SLICE_MS" > $PARAMS/arb_slice_ms
    log "applied: enabled=$ENABLED arb_max=$(cat $PARAMS/arb_max) upstream_weight=$(cat $PARAMS/arb_upstream_weight 2>/dev/null || echo n/a) arb_slice_ms=$(cat $PARAMS/arb_slice_ms) (max command size takes effect at next boot)"
    [ "$ENABLED" = yes ] && ! names_recorded && rebind
  elif [ "$ENABLED" = yes ]; then
    start
  fi
}

stop() {
  loaded || { rm -f $RULE; udevadm control --reload; return 0; }
  echo 0 > $PARAMS/arb_max
  rm -f $RULE; udevadm control --reload
  if names_recorded; then
    log "arbiter set to off; drives stay on uas_arb until the next boot (moving them now would rename the array disks)"
    return 0
  fi
  local i id
  for i in /sys/bus/usb/drivers/uas_arb/*:1.0; do
    [ -e "$i" ] || continue; id=$(basename "$i")
    echo "$id" > /sys/bus/usb/drivers/uas_arb/unbind; echo "$id" > /sys/bus/usb/drivers/uas/bind && log "moved $id back to uas"
  done
  rmmod uas_arb && log "uas_arb unloaded"
}

status() {
  echo "kernel: $KR"
  echo "settings: enabled=$ENABLED limit=$ARB_LIMIT upstream_weight=$UPSTREAM_WEIGHT slice=${ARB_SLICE_MS}ms max_sectors=$MAX_SECTORS match=$MATCH"
  if loaded; then
    echo "module: loaded, driver $(cat /sys/module/uas_arb/version 2>/dev/null || echo 3.0) (arb_max=$(cat $PARAMS/arb_max) upstream_weight=$(cat $PARAMS/arb_upstream_weight 2>/dev/null || echo 'n/a (v2 build)') slice=$(cat $PARAMS/arb_slice_ms)ms max_sectors=$(cat $PARAMS/arb_max_sectors 2>/dev/null || echo n/a) grants=$(cat $PARAMS/arb_grants) denies=$(cat $PARAMS/arb_denies) kicks=$(cat $PARAMS/arb_kicks 2>/dev/null))"
  elif [ -f "$MOD" ]; then echo "module: cached for $KR, not loaded"
  else echo "module: none for $KR"; fi
  local i dev drv blk
  for i in /sys/bus/usb/devices/*:1.0; do
    dev=$(dirname "$(readlink -f "$i")")
    [ "$(cat $dev/idVendor 2>/dev/null):$(cat $dev/idProduct 2>/dev/null)" = "174c:55aa" ] || continue
    drv=$(basename "$(readlink -f "$i/driver" 2>/dev/null)" 2>/dev/null)
    blk=$(ls -d $i/host*/target*/*/block/* 2>/dev/null | xargs -r -n1 basename | tr '\n' ' ')
    echo "bridge $(basename "$i"): driver=${drv:-none} disk=${blk:-?} speed=$(cat $dev/speed 2>/dev/null)M $(is_target "$dev" && echo target || echo ignored)"
  done
  echo "unraid: md_sync_limit=$(sed -n 's/^md_sync_limit="\{0,1\}\([0-9]*\).*/\1/p' /boot/config/disk.cfg) md_num_stripes=$(sed -n 's/^md_num_stripes="\{0,1\}\([0-9]*\).*/\1/p' /boot/config/disk.cfg) (stripes: recommended 32768, min 8192; sync limit: 5 = shares stay responsive, up to 80 = faster checks)"
  local slow=$(slow_bridges | tr '\n' ' ')
  [ -n "$slow" ] && echo "WARNING: not on USB 3: $slow - replug the enclosure's USB cable (not power) with the array stopped"
  echo "recent uas resets since boot: $(dmesg | grep -c 'uas_eh_device_reset_handler start')"
}

case "$1" in
  start) start ;;
  apply) apply ;;
  stop) stop ;;
  rebind) rebind "$2" ;;
  # udev, after a (re)connect: a re-enumerated bridge is a new device, so moving it is safe even with the array started
  rebind-later) sleep 3; log "udev: $2 (re)connected, moving it to uas_arb if needed"; rebind "$2" ;;
  status) status ;;
  *) echo "usage: $0 {start|apply|stop|rebind [iface]|status}"; exit 1 ;;
esac
]]></INLINE>
</FILE>

<!-- settings page -->
<FILE Name="&emhttp;/UASArb.page">
<INLINE><![CDATA[
Menu="Utilities"
Title="DS-SC5B UAS Arbiter"
Icon="hdd-o"
Tag="hdd-o"
---
<?php
$plugin = 'uas-arb';
$cfg = parse_plugin_cfg($plugin);
$status = htmlspecialchars(shell_exec("/usr/local/emhttp/plugins/$plugin/scripts/uas-arb status 2>&1") ?? '');
$disk = @parse_ini_file('/boot/config/disk.cfg') ?: [];
$sync = (int)($disk['md_sync_limit'] ?? 5);
$stripes = (int)($disk['md_num_stripes'] ?? 1280);
?>
<style>pre.uasarb{background:var(--background-color,#1c1b1b);padding:10px;white-space:pre-wrap}</style>

Limits how many drives in a **Sabrent DS-SC5B** (and similar cascaded-hub USB enclosures with ASMedia `174c:55aa` bridges) may have commands in flight at once, so the enclosure stops losing UAS completions and resetting drives during parity checks.
Details, test results and source: [github.com/davilaa/ds-sc5b-uas-arbiter](https://github.com/davilaa/ds-sc5b-uas-arbiter)

<?if ($stripes < 8192):?>
<p style="color:#e68a00"><i class="fa fa-warning"></i> Parity checks will be slow with the arbiter unless you raise <b>Settings → Disk Settings</b>:
<b>md_num_stripes</b> = 32768, or at least 8192 (now <?=$stripes?>). <b>md_sync_limit</b> (now <?=$sync?>) is a trade-off: 5 keeps shares responsive during a check, up to 80 makes the check faster.</p>
<?endif;?>

<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$plugin?>/<?=$plugin?>.cfg">
<input type="hidden" name="#command" value="/plugins/<?=$plugin?>/scripts/uas-arb">
<input type="hidden" name="#arg[1]" value="apply">

Enable arbiter:
: <select name="ENABLED">
  <?=mk_option($cfg['ENABLED'], "yes", "Yes")?>
  <?=mk_option($cfg['ENABLED'], "no", "No (stock behaviour)")?>
  </select>

> **No** sets the arbiter to unlimited immediately. Drives stay bound to `uas_arb` until the next boot.

Activity limit (arb_max):
: <select name="ARB_LIMIT">
  <?for ($n=1; $n<=6; $n++):?><?=mk_option($cfg['ARB_LIMIT'], "$n", "$n".($n==4?" (recommended for DS-SC5B)":""))?><?endfor;?>
  </select>

> Total "weight" of drives allowed to have commands in flight at once. Each bay behind the second hub weighs 1, bay 1 weighs the value below.
> On the DS-SC5B, bay 1 plus 3 busy bays behind the second hub stalls; limit 4 with bay-1 weight 2 never allows that.

Bay 1 weight (arb_upstream_weight):
: <select name="UPSTREAM_WEIGHT">
  <?=mk_option($cfg['UPSTREAM_WEIGHT'], "2", "2 (recommended)")?>
  <?=mk_option($cfg['UPSTREAM_WEIGHT'], "1", "1 (all bays equal; use limit 3)")?>
  </select>

Turn length in ms (arb_slice_ms):
: <input type="number" name="ARB_SLICE_MS" min="5" max="1000" value="<?=htmlspecialchars($cfg['ARB_SLICE_MS'])?>" class="narrow">

> How long a drive may keep its slot while others are waiting. 100 gave the best Unraid parity speed.

Max command size:
: <select name="MAX_SECTORS">
  <?=mk_option($cfg['MAX_SECTORS'], "4096", "2 MB (recommended)")?>
  <?=mk_option($cfg['MAX_SECTORS'], "2048", "1 MB")?>
  <?=mk_option($cfg['MAX_SECTORS'], "0", "512 KB (kernel default)")?>
  </select>

> Takes effect at the next boot.

Which bridges to manage:
: <select name="MATCH">
  <?=mk_option($cfg['MATCH'], "dssc5b", "ASM235CM behind a VIA VL822 hub (DS-SC5B)")?>
  <?=mk_option($cfg['MATCH'], "all", "All ASMedia 174c:55aa bridges")?>
  </select>

> Changes to the bridge selection take effect at the next boot (drives are never moved while the array is started).

&nbsp;
: <input type="submit" value="Apply"><input type="button" value="Done" onclick="done()">
</form>

### Status
<pre class="uasarb"><?=$status?></pre>
]]></INLINE>
</FILE>

<FILE Name="&emhttp;/README.md">
<INLINE><![CDATA[
**DS-SC5B UAS Arbiter**

Loads a patched Linux UAS driver (`uas_arb`) that limits how many drives in a Sabrent DS-SC5B
(2x VIA VL822 + 5x ASMedia ASM235CM) may have commands in flight at once. Stops the
`uas_eh_abort_handler` / USB reset loops during parity checks. Settings: Settings > User Utilities.
]]></INLINE>
</FILE>

<!-- install / every boot: load the module before the array starts -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &plugin;/modules
# warn about a leftover manual setup from /boot/config/go
if grep -q "uas_arb.ko" /boot/config/go 2>/dev/null; then
  echo "NOTE: /boot/config/go still loads uas_arb manually; remove those lines, the plugin handles it now."
fi
&emhttp;/scripts/uas-arb start
echo ""
echo "DS-SC5B UAS Arbiter &version; installed. Settings > User Utilities > DS-SC5B UAS Arbiter"
</INLINE>
</FILE>

<!-- uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
&emhttp;/scripts/uas-arb stop
rm -rf &emhttp; &plugin;
rm -f /etc/udev/rules.d/99-uas-arb.rules
echo "DS-SC5B UAS Arbiter removed. If the array was started, reboot to return the drives to the stock uas driver."
</INLINE>
</FILE>

</PLUGIN>
